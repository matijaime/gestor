# ── Firebase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── API key para el atajo de iPhone ──────────────────────────────────────────
# Generá una clave aleatoria larga, ej: openssl rand -hex 32
SHORTCUTS_API_KEY=pon_aqui_tu_clave_secreta_larga

# ── UID de tu cuenta de Google (lo ves en Firebase Console → Authentication) ─
SHORTCUTS_OWNER_UID=

# ── Firebase Admin SDK (para la API de Shortcuts, server-side) ───────────────
# Descargá el JSON de Service Account desde Firebase Console →
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La private_key tiene saltos de línea: copiá el contenido completo entre comillas
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
